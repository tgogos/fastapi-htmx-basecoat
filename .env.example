# Docker Configuration
# -------------------
DOCKER_REG=
DOCKER_REPO=
APP_NAME=fastapi-htmx-basecoat
DOCKER_TAG=latest

# Application Configuration
# -----------------------
VERSION=0.0.1
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING | ERROR | CRITICAL; JSON logs when ENVIRONMENT=production
PUBLISH_PORT=8000

# Session auth (change SECRET_KEY in any shared/deployed environment)
SECRET_KEY=dev-secret-change-me
SESSION_COOKIE_NAME=fastapi_htmx_bootstrap_session

# Demo user seeded when the users table is empty
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123

# SQLite relational DB (file is created automatically)
DATABASE_URL=sqlite:///./data/app.db

# MongoDB Configuration
MONGO_USER=root
MONGO_PASS=pass
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_AUTH_SOURCE=admin
MONGO_DATABASE=fastapi_htmx_bootstrap
